<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PasswordManager.PasswordGeneratorPage"
             Title="&#x0413;&#x0435;&#x043D;&#x0435;&#x0440;&#x0430;&#x0442;&#x043E;&#x0440; &#x043F;&#x0430;&#x0440;&#x043E;&#x043B;&#x0435;&#x0439;">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="&#x0417;&#x0430;&#x043A;&#x0440;&#x044B;&#x0442;&#x044C;"
                     Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="24"
                         Spacing="16">
        <Label Text="&#x0412;&#x044B;&#x0431;&#x0435;&#x0440;&#x0438;&#x0442;&#x0435; &#x0441;&#x043B;&#x043E;&#x0436;&#x043D;&#x043E;&#x0441;&#x0442;&#x044C;"
               FontAttributes="Bold" />

        <Picker x:Name="ComplexityPicker"
                Title="&#x0421;&#x043B;&#x043E;&#x0436;&#x043D;&#x043E;&#x0441;&#x0442;&#x044C;"
                ItemsSource="{Binding ComplexityLevels}"
                SelectedIndex="1" />

        <Button Text="&#x0421;&#x0433;&#x0435;&#x043D;&#x0435;&#x0440;&#x0438;&#x0440;&#x043E;&#x0432;&#x0430;&#x0442;&#x044C;"
                Clicked="OnGenerateClicked" />

        <Entry x:Name="GeneratedPasswordEntry"
               Placeholder="&#x0421;&#x0433;&#x0435;&#x043D;&#x0435;&#x0440;&#x0438;&#x0440;&#x043E;&#x0432;&#x0430;&#x043D;&#x043D;&#x044B;&#x0439; &#x043F;&#x0430;&#x0440;&#x043E;&#x043B;&#x044C;"
               IsPassword="True" />

        <HorizontalStackLayout Spacing="8">
            <Button x:Name="TogglePasswordButton"
                    Text="&#x041F;&#x043E;&#x043A;&#x0430;&#x0437;&#x0430;&#x0442;&#x044C;"
                    Clicked="OnTogglePasswordClicked" />
            <Button Text="&#x0418;&#x0441;&#x043F;&#x043E;&#x043B;&#x044C;&#x0437;&#x043E;&#x0432;&#x0430;&#x0442;&#x044C; &#x043F;&#x0430;&#x0440;&#x043E;&#x043B;&#x044C;"
                    Clicked="OnUsePasswordClicked" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>  